# copy to .env and fill in; docker compose interpolates from here,
# the dev server loads the same file via tsx --env-file

POSTGRES_PASSWORD=
# dev-only: server on the host connects to the published db port
DATABASE_URL=postgres://area_photo_map:SET-SAME-PASSWORD@127.0.0.1:5432/area_photo_map

# Traefik routing
APP_DOMAIN=photos.localhost
CERT_RESOLVER=letsencrypt
APP_PORT=3000

# dev-only: API port the vite dev server proxies to
PORT=3001